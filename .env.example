# Never put secrets in this file or commit populated .env files.
# Supply the token only through your local shell or approved secret manager.
# PAYBOX_ACCESS_TOKEN is read by paybox_mcp_discover; it is never a tool argument.
# PAYBOX_ACCESS_TOKEN=<set-locally-not-here>

# REAL-FUNDS GUARD: keep false/unset until PayBox OAuth and local transaction tests pass.
# VELTRION_PAYBOX_EXECUTION_ENABLED=false

# Optional LLM agent via Vercel AI Gateway. Never commit real values.
# AI_GATEWAY_API_KEY=<set-locally-not-here>
# VELTRION_LLM_MODEL=<provider/model-id-from-current-gateway-catalog>

# Optional standalone x402 V2 receiver. Disabled unless explicitly set to true.
# Base mainnet USDC exact scheme only. Choose and verify your own receiving address.
# X402_RECEIVE_ENABLED=false
# X402_RECEIVE_PAY_TO=0x<your-chosen-base-mainnet-address>
# X402_RECEIVE_PRICE_USDC=0.01
# X402_FACILITATOR_URL=https://<approved-facilitator-base-url>/
# X402_PUBLIC_URL=https://<your-deployed-https-origin>/
# X402_RECEIVE_HOST=127.0.0.1
# X402_RECEIVE_PORT=8787
