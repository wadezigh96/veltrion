# Never put secrets in this file or commit populated .env files.
# Supply the token only through your local shell or approved secret manager.
# PAYBOX_ACCESS_TOKEN is read by paybox_mcp_discover; it is never a tool argument.
# PAYBOX_ACCESS_TOKEN=<set-locally-not-here>

# Optional LLM agent via Vercel AI Gateway. Never commit real values.
# AI_GATEWAY_API_KEY=<set-locally-not-here>
# VELTRION_LLM_MODEL=<provider/model-id-from-current-gateway-catalog>
